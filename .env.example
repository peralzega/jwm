# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://jwm_app:GANTI_SANDI@localhost:5432/jwm?sslmode=disable
SESSION_COOKIE_SECURE=false

# Admin pertama (dipakai sekali oleh cmd/seed). Wajib ganti sandi saat login pertama.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Pembatasan jaringan halaman admin, contoh: 10.0.0.0/8,203.0.113.0/24
ADMIN_ALLOWED_CIDRS=

# Email notifikasi (SMTP Google Workspace). Metode final perlu dikonfirmasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=