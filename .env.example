# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://jwm_app:GANTI_SANDI@localhost:5432/jwm?sslmode=disable
SESSION_COOKIE_SECURE=false

# Sesi dan login (nilai default di bawah; boleh dikosongkan).
SESSION_IDLE_TTL=8h
SESSION_ABSOLUTE_TTL=168h
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_BASE=1m
LOGIN_LOCKOUT_MAX=30m
LOGIN_RATE_PER_MINUTE=10

# Admin pertama (dipakai sekali oleh cmd/seed). Wajib ganti sandi saat login pertama.
# Kosongkan BOOTSTRAP_ADMIN_PASSWORD setelah seed berhasil.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Pembatasan jaringan halaman admin, contoh: 10.0.0.0/8,203.0.113.0/24
ADMIN_ALLOWED_CIDRS=

# CIDR reverse proxy yang dipercaya untuk header X-Forwarded-For. Kosong = abaikan header.
TRUSTED_PROXIES=

# Database khusus tes integrasi (skema sementara dibuat dan dihapus per tes).
# Bila kosong, tes memakai Docker (testcontainers) atau di-skip.
TEST_DATABASE_URL=

# Email notifikasi (SMTP Google Workspace). Metode final perlu dikonfirmasi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=